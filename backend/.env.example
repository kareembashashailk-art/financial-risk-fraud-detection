# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key

# Database Connection
# Default SQLite fallback (recommended for zero-config local development):
DATABASE_URL=sqlite:///financial_risk.db

# MySQL Connection (uncomment and configure when running with MySQL server):
# DATABASE_URL=mysql+pymysql://fraud_user:fraud_password@127.0.0.1:3306/financial_risk_db

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
MAX_CONTENT_LENGTH=16777216
